# ---------------------------------------------------------------------------
# CERO · variables de entorno
# Copia este archivo como .env.local y rellena los valores de tu proyecto.
# NUNCA subas .env.local al repositorio.
# ---------------------------------------------------------------------------

# Supabase · Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL publica de la app (para los enlaces de correo de Supabase Auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Zona horaria de la app (vencimientos y fechas de cuota)
NEXT_PUBLIC_APP_TZ=America/Bogota

# Moneda por defecto
NEXT_PUBLIC_DEFAULT_CURRENCY=COP

# Cobros SaaS · valores públicos que aparecen en la pantalla de pago
NEXT_PUBLIC_PAYMENT_KEY=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Wompi · secretos exclusivos del servidor
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# SOLO SERVIDOR · nunca exponer con prefijo NEXT_PUBLIC_
# Necesaria para webhooks, comprobantes SaaS y scripts de mantenimiento.
# Se importa únicamente en módulos `server-only`; nunca entra al bundle cliente.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
